# ============================================================
# WayGo Backend — Production Environment Variables Template
# ============================================================
# Bu faylni serverga ko'chirib, .env nomini bering
# va BARCHA qiymatlarni real kalitlarga o'zgartiring!
# ============================================================

# --- Database ---
SPRING_DATASOURCE_PASSWORD=your_strong_db_password_here

# --- Multicard Acquiring ---
# Multicard dashboard dan olinadi (prod akkount)
MULTICARD_APPLICATION_ID=your_prod_application_id
MULTICARD_SECRET=your_prod_secret_key
MULTICARD_STORE_ID=your_prod_store_id
MULTICARD_BASE_URL=https://mesh.multicard.uz
WAYGO_BACKEND_URL=https://backend.waygo.uz

# --- Payme Merchant ---
# Payme Merchant kabinetidan olinadi
PAYME_MERCHANT_KEY=your_payme_merchant_key
PAYME_LOGIN=Paycom

# --- Eskiz SMS ---
# https://eskiz.uz dan olinadi
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password
ESKIZ_FROM=4546
SMS_PROVIDER=eskiz

# --- JWT ---
# Kamida 64 belgili tasodifiy string (openssl rand -hex 32)
WAYGO_JWT_SECRET=generate_a_strong_64_char_random_string_here
